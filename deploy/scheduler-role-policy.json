{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunStriaxTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": [
        "arn:aws:ecs:__REGION__:__ACCOUNT__:task-definition/__NAME__",
        "arn:aws:ecs:__REGION__:__ACCOUNT__:task-definition/__NAME__:*"
      ]
    },
    {
      "Sid": "PassStriaxRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::__ACCOUNT__:role/__NAME__-execution-role",
        "arn:aws:iam::__ACCOUNT__:role/__NAME__-task-role"
      ],
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    }
  ]
}
