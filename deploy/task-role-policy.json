{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStriaxBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ReadWriteStriaxObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    }
  ]
}
